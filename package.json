{
  "name": "obsidian-screenshot-importer",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "Import screenshots and images into Obsidian media notes with matching, compression, episode organization, and rollback.",
  "repository": {
    "type": "git",
    "url": "https://github.com/theambinder/obsidian-screenshot-importer.git"
  },
  "scripts": {
    "build:native": "/bin/bash scripts/build-native-helpers.sh",
